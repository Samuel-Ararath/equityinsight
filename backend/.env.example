# Copy to .env and replace this with a long random secret before starting.
API_ACCESS_TOKEN=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=900
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Add only provider credentials you are entitled to use, if needed by OpenBB.
# Keep these in the backend environment; never add them to NEXT_PUBLIC_* variables.
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# FMP_API_KEY=