{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "market_api",
          "format": "url",
          "env": "MARKET_API_URL"
        }
      ]
    },
    "market_api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "market_api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "market_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
