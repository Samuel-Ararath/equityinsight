{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "./",
      "framework": "nextjs"
    },
    "market_api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "market_api" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "market_api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
